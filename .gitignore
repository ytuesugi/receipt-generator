.DS_Store
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Keep personal receipt data and generated files out of Git.
input/*
!input/example.json
!input/sheet-example.json
!input/sheet-example.csv
output/*
!output/example/
output/example/*
!output/example/2000-01-01_テスト太郎.pdf
!output/example/2000-01-01_サンプル花子.pdf

# Stamp images may contain identifying information.
assets/*
!assets/README.md
!assets/sample-stamp.png
